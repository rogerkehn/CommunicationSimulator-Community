  <ScriptingCode>
    <ScriptCode>using System;
using System.Collections.Generic;
using System.Text;
using Common;
using Common_DataTypes;
using MessageHandlerSystem;

//Use the static class "Helpers" for common tasks like converting bytes to strings...
//Use "Break();" for debugging with visual studio or SharpDevelop http://www.icsharpcode.net/OpenSource/SD/Download/

class SimulatorScripting : IMessageWindowConverters, ISendBoxConverters, IAutoResponseScripting, IStartStopNotification
{

	//Called after the simulator file has successfully loaded
	public void SimulatorFileLoaded()
	{
		
	}
	
	//Called once the network connection is made to remote device or COM port has been opened
	public void SimulatorConnected()
	{
		
	}
	
	//Called once the network connection is broken to remote device or COM port has been closed
	public void SimulatorDisconnected()
	{
		
	}
	
	//Called as each chuck of data arrives from the .NET framework to allow the users script to determine when full message has been received.
	//Message termination mode must be set to "Script"
	public MessagePacket PacketReceived(DataPacket dataPacket)
	{
		//EXAMPLE MessagePacket
		//MessagePacket messagePacket = new MessagePacket();
		//messagePacket.Data = dataPacket.Data;
		//messagePacket.DataPacket = dataPacket;
		//messagePacket.TimeStamp = dataPacket.TimeStamp;
		//return messagePacket;	

		return null; //return null if script has not yet detected a full message 
	}
	
	//Called just after a full message is detected. Allows manipulation of the received message packet before further processing.
	public MessagePacket MessageReceived(MessagePacket messagePacket)
	{
		return messagePacket; 
	}
	
	//Called any time something tries to write to message window. Allows the manipulation of what is to be writen to the message window.
	public string MessageWindowConverter(byte[] data)
	{
		//Example of how to make a custom message for message window
		if (data != null &amp;&amp; data.Length &gt; 0)
		{
			string BytesAsString = Helpers.ByteArrayToString(data);
			string BytesAsHexString = BitConverter.ToString(data);
			string BytesLengthAsString = data.Length.ToString();

			return BytesAsString.Trim() + " / " + BytesAsHexString + " / Length:" + BytesLengthAsString;

		}

		return "";
	}

	//Called when the user clicks the send button
	//Send Box converter mode must be set to "Script"
	public byte[] SendBoxConverter(string text)
	{
		return Helpers.StringToByteArray(text);
	}

	//Called just before Auto Response System
	public byte[] PreAutoResponseHandler(MessagePacket messagePacket)
	{
		// Returning "null" means auto reponse grid will still check for match
		// Returning a array of bytes will bypassing auto reponse grid, it is considered handled
		
		return null; 
	}

	//Called just after Auto Response Systems 
	public byte[] PostAutoResponseHandler(byte[] data)
	{
		return data;
	}

	//Called just before data is sent
	public byte[] SendingBytesManipulationScript(byte[] data)
	{
		return data;
	}
	
	//Called when the user click/unclicks the play button on the tool bar
	public void UserPressedStartStopToolbarButton(StartStopNotification notification)
	{
		
	}

	//Called only if a debugger is attached
    //Place this in your code to allow debugger to connect
	public void Break()
	{
		if(System.Diagnostics.Debugger.IsAttached) System.Diagnostics.Debugger.Break();
	}

}</ScriptCode>
  </ScriptingCode>
  <RepeatValue>1</RepeatValue>
  <Communication_Type>TCP_Listen</Communication_Type>
  <Log_To_File>false</Log_To_File>
  <Log_Folder />
  <Log_MaxFiles>0</Log_MaxFiles>
  <Notes>HIOKI PW4001 common-command teaching/test simulator, not real hardware. Manual PW4001A971-00 Oct 2025. 28 quick buttons / 29 table rows. CH1 230 V, 5 A, ~1035 W, 50 Hz with bounded random variation; 50 A sensor range profile. TCP test listener port 5023 (real device port 23). CRLF replies, LF/CRLF requests. HEADER OFF default; HEAD ON supported. Only listed single commands and fixed U/I/P/f combination supported. No arbitrary MEAS lists, semicolon compound paths, full event registers, integration, waveform/harmonic output, sensor dynamics or metrological accuracy. Unknown/invalid queries are silent. Random measurements do not model range clipping or exact cross-value physics. Auto Respond must be enabled manually. Never use simulated identity/results as hardware qualification.</Notes>
